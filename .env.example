# Copiar a .env.local. En local apunta al Postgres de docker-compose.yml.
DATABASE_URL=postgres://finanzas:finanzas@localhost:5433/finanzas

# Supabase Auth del proyecto de desarrollo "finanzas-dev" (spec 002). Solo de servidor: nunca NEXT_PUBLIC_.
# La clave es la publicable (sb_publishable_...); la secreta no se usa en ningún lado.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# El único correo que puede entrar. Si falta, nadie entra.
USUARIO_PERMITIDO=
# Usuario de prueba de finanzas-dev para pnpm humo en modo con sesión.
HUMO_CORREO=
HUMO_CLAVE=

# La cadena de producción no se guarda en ningún archivo: los comandos :produccion la piden, oculta, en la terminal.
# Es la del pooler de Supabase en modo sesión (puerto 5432, usuario postgres.<ref>) con ?sslmode=require; se guarda
# en el gestor de contraseñas.
