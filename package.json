{
  "name": "finanzas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:produccion": "tsx src/db/migrar-produccion.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:produccion": "tsx src/db/seed.ts --produccion",
    "db:demo": "tsx src/db/semilla-demo.ts",
    "db:demo:limpiar": "tsx src/db/semilla-demo.ts --limpiar",
    "db:respaldo:produccion": "tsx src/db/respaldo.ts --produccion",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify:fast": "node scripts/verificar.mjs fast",
    "verify": "node scripts/verificar.mjs",
    "humo": "node scripts/humo.mjs",
    "capturas": "node scripts/capturas.mjs",
    "estructura": "node scripts/estructura.mjs --todo"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "ignore": "7.0.12",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.4"
}
